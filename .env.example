# AtherOps Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ── API ─────────────────────────────────────────────────────────────────────
API_VERSION=v1
API_PREFIX=/api

# ── PostgreSQL Database ──────────────────────────────────────────────────────
# All fields are required. The application will refuse to start without them.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name_here
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here

# Connection pool sizing (optional – sensible defaults apply if omitted)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only in development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Authentication (Phase 2) ──────────────────────────────────────────────────
# Required. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_at_least_32_characters_here
JWT_EXPIRES_IN=15m
JWT_ISSUER=atherops
JWT_AUDIENCE=atherops-api
COOKIE_NAME=atherops_token

# Auth-specific rate limiting (stricter than global)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ── Future phases ─────────────────────────────────────────────────────────────
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Optional: Hardened AWS Connection ──
# To allow customers to connect their AWS accounts securely, AtherOps needs to provide
# the customer with the IAM principal ARN that AtherOps uses to assume roles.
# Set this to the exact IAM role/user ARN that runs the AtherOps backend (e.g. EC2 instance profile role).
# ATHEROPS_SERVICE_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/AtherOpsBackendExecutionRole
