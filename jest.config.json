{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/tests"],
  "setupFiles": ["<rootDir>/tests/setup.ts"],
  "testMatch": ["**/*.test.ts"],
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": {
          "strict": true,
          "esModuleInterop": true,
          "module": "commonjs",
          "target": "ES2022"
        }
      }
    ]
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/server.ts"
  ],
  "coverageDirectory": "coverage",
  "coverageReporters": ["text", "lcov"],
  "verbose": true,
  "testTimeout": 15000
}
